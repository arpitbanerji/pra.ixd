# ============================================================================
# Telegram
# ============================================================================
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=8888868838:AAEbM4GWzI0pVYWSRLaxZlefUfn1nVcWymM

# Comma-separated Telegram user IDs allowed to drive the agent.
# Leave empty on the very first run: message the bot and it will reply with
# your numeric ID, then paste it here and restart. While empty, nobody has
# access (this is safe, not broken).
# Example: 123456789  or  123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=1576597156
# Set true ONLY if you deliberately want anyone on Telegram to use your agent.
TELEGRAM_ALLOW_ALL=false
# Optional egress proxy for regions where Telegram is blocked.
# TELEGRAM_PROXY=socks5://user:pass@host:1080

# ============================================================================
# OpenHands backend
# ============================================================================
# local = an agent-server you host (default) | cloud = app.all-hands.dev
OPENHANDS_MODE=cloud
# Where the agent server is, as seen FROM THE OHBOT CONTAINER.
# host.docker.internal only works if port 18000 is published to your host.
# Unsure? Run: docker compose exec ohbot python scripts/check_backend.py --probe
OPENHANDS_BASE_URL=https://app.all-hands.dev

# local mode: the agent server session key (X-Session-API-Key)
OPENHANDS_SESSION_API_KEY=

# cloud mode: your OpenHands Cloud API key (Bearer)
OPENHANDS_CLOUD_API_KEY=sk-oh-wZeHuavv68qQarVpv1VlwCVEnCd7w6zi

# Optional: pin a specific agent profile (UUID). Auto-detected when empty.
OPENHANDS_AGENT_PROFILE_ID=

# Workspace the agent operates in, from the agent server's point of view.
OPENHANDS_WORKSPACE_DIR=/workspace

OPENHANDS_MAX_ITERATIONS=200
# never = fully autonomous | always = approve each action from Telegram
OPENHANDS_CONFIRMATION_POLICY=never
OPENHANDS_REQUEST_TIMEOUT=60

# ============================================================================
# Behaviour
# ============================================================================
POLL_INTERVAL_SECONDS=2
RUN_TIMEOUT_SECONDS=1800
STREAM_PROGRESS=true
PROGRESS_EDIT_INTERVAL_SECONDS=3

# ============================================================================
# Ops
# ============================================================================
DB_PATH=/data/ohbot.sqlite3
LOG_LEVEL=INFO
LOG_JSON=true
HEALTH_PORT=8080
